<mvc:View controllerName="sap.training.exc.controller.Overview"
          xmlns:mvc="sap.ui.core.mvc"  
          xmlns="sap.m"
          xmlns:f="sap.ui.layout.form"
          core:require="{formatter: 'sap/training/exc/model/formatter'}"
          xmlns:core="sap.ui.core">
          
<Page title="Flight Customers" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <Panel headerText="{i18n>newCustomerPanelTitle}" expandable="true" expanded="true" class="sapUiResponsiveMargin sapUiHideOnPhone" width="auto">
                <content>
                    <f:SimpleForm layout="ColumnLayout" editable="true">
                        <f:toolbar>
                            <Toolbar>
                                <content>
                                    <ToolbarSpacer/>
                                    <Button icon="sap-icon://create" text="{i18n>createCustomerButtonText}" press=".onSave" 
                                    enabled="{= ${customer>/CustomerName} !== undefined &amp;&amp; ${customer>/CustomerName}.length > 0 }"/>
                                </content>
                            </Toolbar>
                        </f:toolbar>
                        

                        <f:content>
                            <core:Title text="{i18n>generalDataTitle}"/>
                            <Label text="{i18n>formLabel}"/>
                            <Input value="{customer>/Form}"/>

                            <Label text="{i18n>customerNameLabel}"/>
                            <Input
                                value="{customer>/CustomerName}"
                                valueLiveUpdate="true"/>

                            <Label text="{i18n>discountLabel}"/>
                            <Input value="{
                                path: 'customer>/Discount',
                                type: 'sap.ui.model.type.Integer',
                                constraints: {
                                    minimum: 0,
                                    maximum: 100
                                }
                            }"/>

                            <core:Title text="{i18n>addressDataTitle}"/>
                            <Label text="{i18n>streetLabel}"/>
                            <Input value="{customer>/Street}"/>

                            <Label text="{i18n>postCodeLabel}"/>
                            <Input value="{customer>/PostCode}"/>

                            <Label text="{i18n>cityLabel}"/>
                            <Input value="{customer>/City}"/>

                            <Label text="{i18n>countryLabel}"/>
                            <Input value="{customer>/Country}"/>

                            <core:Title text="{i18n>contactDataTitle}"/>
                            <Label text="{i18n>emailLabel}"/>
                            <Input value="{customer>/Email}"/>

                            <Label text="{i18n>telephoneLabel}"/>
                            <Input value="{customer>/Telephone}"/>
                        </f:content>
                    </f:SimpleForm>
                </content>
            </Panel>
                        <Table
                            id="customerTable"
                            growing="true"
                            growingThreshold="5"
                            class="sapUiResponsiveMargin"
                            width="auto"
                            mode="SingleSelectLeft"
                            selectionChange=".onCustomerChange"
                            items="{
                                path: '/UX_Customer',                                
                                sorter: [
                                    {path: 'City', group: true},
                                    {path: 'CustomerName'}
                                ]
                            }">
                            
                            <headerToolbar>
                                <Toolbar>
                                    <Title text="{i18n>customersTableTitle}"/>
                                    <ToolbarSpacer/>
                                    <SearchField width="{= ${device>/system/phone} ? '100%' : '40%' }" search=".onFilterCustomers"/>
                                </Toolbar>
                            </headerToolbar>


                            <columns>
                                <Column>
                                    <header>
                                        <Text text="{i18n>customerNameColumn}"/>
                                    </header>
                                </Column>

                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <header>
                                        <Text text="{i18n>streetColumn}"/>
                                    </header>
                                </Column>

                                <Column minScreenWidth="Desktop" demandPopin="true">
                                    <header>
                                        <Text text="{i18n>postCodeColumn}"/>
                                    </header>
                                </Column>

                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <header>
                                        <Text text="{i18n>cityColumn}"/>
                                    </header>
                                </Column>

                                <Column minScreenWidth="Desktop" demandPopin="true">
                                    <header>
                                        <Text text="{i18n>countryColumn}"/>
                                    </header>
                                </Column>

                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <header>
                                        <Text text="{i18n>emailColumn}"/>
                                    </header>
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <ObjectIdentifier title="{CustomerName}"/>
                                        <Text text="{Street}"/>
                                        <Text text="{PostCode}"/>
                                        <Text text="{City}"/>
                                        <Text text="{Country}"/>
                                        <Text text="{Email}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                        <Table
                            id="bookingTable"
                            headerText="{i18n>bookingsTableTitle}"
                            items="{_Bookings}"
                            growing="true"
                            growingThreshold="5"
                            class="sapUiResponsiveMargin"
                            width="auto">

                            <columns>
                                <Column>
                                    <header>
                                        <Text text="{i18n>airlineIdColumn}"/>
                                    </header>
                                </Column>

                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <header>
                                        <Text text="{i18n>connectionNumberColumn}"/>
                                    </header>
                                </Column>

                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <header>
                                        <Text text="{i18n>flightDateColumn}"/>
                                    </header>
                                </Column>

                                <Column minScreenWidth="Tablet" demandPopin="true">
                                    <header>
                                        <Text text="{i18n>classColumn}"/>
                                    </header>
                                </Column>

                                <Column minScreenWidth="Desktop" demandPopin="true">
                                    <header>
                                        <Text text="{i18n>foreignCurrencyPaymentColumn}"/>
                                    </header>
                                </Column>

                                <Column minScreenWidth="Desktop" demandPopin="true">
                                    <header>
                                        <Text text="{i18n>cancellationStatusColumn}"/>
                                    </header>
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <ObjectIdentifier title="{AirlineID}"/>
                                        <ObjectIdentifier title="{ConnectionNumber}"/>
                                        <ObjectIdentifier title="{
                                            path: 'FlightDate',
                                            type: 'sap.ui.model.type.Date',
                                            formatOptions: {
                                                source: {
                                                    pattern: 'yyyy-MM-dd'
                                                },
                                                style: 'medium'
                                            }
                                        }"/>
                                        <Text text="{
                                            path: 'Class',
                                            formatter: 'formatter.classText'
                                        }"/>
                                        <ObjectNumber
                                            number="{
                                                parts: [
                                                    {path: 'ForeignCurrencyPayment'},
                                                    {path: 'ForeignCurrency'}
                                                ],
                                                type: 'sap.ui.model.type.Currency',
                                                formatOptions: {
                                                    showMeasure: false
                                                }
                                            }"
                                            unit="{ForeignCurrency}"/>
                                        
                                        <core:Icon src="{= ${IsCancelled} === 'X' ? 'sap-icon://cancel' : 'sap-icon://accept' }"
                                        tooltip="{= ${IsCancelled} === 'X' ? 'cancelled' : 'not cancelled' }"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
        </content>
    </Page>

   
</mvc:View>